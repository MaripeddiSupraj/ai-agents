# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4096

# GitHub
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_PR_NUMBER=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# Terraform
TERRAFORM_DIR=./terraform/sample
TERRAFORM_BINARY=terraform

# OPA
OPA_BINARY=opa
OPA_POLICY_DIR=./terraform/sample/policies

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# App
APP_NAME=Terraform Review Agent
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
